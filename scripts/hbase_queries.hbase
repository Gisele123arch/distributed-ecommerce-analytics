
# 1. Verify total number of stored sessions
count 'customer_sessions'

# 2. Display two sample sessions
scan 'customer_sessions', {LIMIT => 2}

# 3. Retrieve sessions belonging to one customer
scan 'customer_sessions',
  {STARTROW => 'user_000000',
   STOPROW => 'user_000001'}

# 4. Display the table structure
describe 'customer_sessions'
